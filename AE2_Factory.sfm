Name "AE2_Factory"

--适用于ATM9的AE2工厂，用于生产常用的处理器以及反应仓产物，较为稳定，产物偶尔会卡反应仓，若遇到自动化不推进请检查反应仓
--(原因是SFM每秒进行一次产物输入，当执行产物输入的瞬间AE2的样板供应器并没有及时提供所需的全类型原料，才会出现这种情况)

--命名规则:  
--Cutter: 电路切片器
--  Cutter_Water: 使用水作为液体原料的电路切片器
--  Cutter_Lava: 使用岩浆作为液体原料的电路切片
--Reaction: 反应仓
--  Reaction_Water: 使用水作为液体原料的反应仓
--  Reaction_Lava: 使用岩浆作为液体原料的反应仓
--  Reaction_Quantum: 使用量子灌注液作为液体原料的反应仓


--能量输送
Every 1 tick do

    Input FE:: From Energy_Src Top Side
        Output FE:: To Each Cutter Bottom Side
        Output FE:: To Each Reaction Bottom Side

End

--电路切片器与反应仓流体维持
Every 20 ticks do
    Input fluid:minecraft:water From ME_Face Top Side Slots 0
        Output retain 16000 Each fluid:minecraft:water To Each Cutter_Water Bottom Side
    forget

    Input fluid:minecraft:water From ME_Face Top Side Slots 0
        Output retain 16000 Each fluid:minecraft:water To Each Reaction_Water Bottom Side
    forget

    Input fluid:minecraft:lava From ME_Face Top Side Slots 1
        Output retain 16000 Each fluid:minecraft:lava To Each Cutter_Lava Bottom Side
    forget

    Input fluid:minecraft:lava From ME_Face Top Side Slots 1
        Output retain 16000 Each fluid:minecraft:lava To Each Reaction_Lava Bottom Side
    forget

    Input fluid:advanced_ae:quantum_infusion_source From ME_Face Top Side Slots 2
        Output retain 16000 Each fluid:advanced_ae:quantum_infusion_source To Each Reaction_Quantum Bottom Side
    forget
    
End

--电路切片器原料输入与产物输出
Every 20 ticks do

    Input Except megacells:sky_steel_block From Ingredient_Cutter Top Side
        Output retain 2 Each Except megacells:sky_steel_block To Each Cutter_Water Bottom Side
    forget

    Input megacells:sky_steel_block From Ingredient_Cutter Top Side
        Output retain 2 Each megacells:sky_steel_block To Each Cutter_Lava Bottom Side
    forget

    Input From Each Cutter Top Side 
        Output To ME_Face Bottom Side Slots 3-35
    forget

End

--反应仓原料输入与产物输出
--一号原料位
Every 20 ticks do

    --充能赛特斯石英
    Input ae2:certus_quartz_crystal From Ingredient_Reaction Top Side
        Output retain 128 Each ae2:certus_quartz_crystal To Each Reaction_Water Bottom Side
    forget

    --福鲁伊克斯水晶 同种液体原料红石粉(与处理器)与充能赛特斯石英水晶(与陨钢锭)碰撞,导致retain维持配方原料比例失衡
    Input
        ae2:charged_certus_quartz_crystal,
        minecraft:redstone,
        minecraft:quartz
    From Ingredient_Reaction Top Side
        Output
            retain 32 Each ae2:charged_certus_quartz_crystal,
            retain 32 Each minecraft:redstone,
            retain 32 Each minecraft:quartz
        To Each Reaction_Water Bottom Side
    forget

    --奇点
    Input ae2:matter_ball From Ingredient_Reaction Top Side
        Output retain 128 Each ae2:matter_ball To Each Reaction_Lava Bottom Side
    forget

    --破碎奇点
    Input 
        thermal:ender_pearl_dust, 
        ae2:singularity, 
        ae2:sky_dust 
    From Ingredient_Reaction Top Side
        Output 
            retain 4 Each thermal:ender_pearl_dust, 
            retain 4 Each ae2:sky_dust,
            retain 2 Each ae2:singularity
    
        To Each Reaction_Lava Bottom Side
    forget

    --量子灌注液
    Input advanced_ae:quantum_infused_dust From Ingredient_Reaction Top Side
        Output retain 2 Each advanced_ae:quantum_infused_dust To Each Reaction_Water Bottom Side
    forget

    Input fluid:advanced_ae:quantum_infusion_source From Each Reaction_Water Top Side 
        Output fluid:advanced_ae:quantum_infusion_source To ME_Face Bottom Side Slots 3-35
    forget

    Input From Each Reaction Top Side 
        Output To ME_Face Bottom Side Slots 3-35
    forget

End

--反应仓原料输入与产物输出
--二号原料位
Every 20 ticks do

    --陨钢锭
    Input 
        ae2:charged_certus_quartz_crystal,
        minecraft:iron_ingot,
        ae2:sky_stone_block
    From Ingredient_Reaction_Extra Top Side
        Output
            retain 32 Each ae2:charged_certus_quartz_crystal,
            retain 32 Each minecraft:iron_ingot,
            retain 32 Each ae2:sky_stone_block
        To Each Reaction_Lava Bottom Side
    forget

    --常用五种处理器(运算、工程、逻辑、累积、量子) 原料碰撞但不分隔是因为相同原料部分的比例都相同，只是其中一种原料发生了改变
    Input
        "ae2:printed_.*_processor",
        "advanced_ae:printed_.*_processor",
        "megacells:printed_.*_processor",
        "ae2:printed_silicon",
        "minecraft:redstone"
    From Ingredient_Reaction_Extra Top Side
        Output
            4 retain 8 ae2:printed_calculation_processor or
                ae2:printed_logic_processor or
                ae2:printed_engineering_processor or
                advanced_ae:printed_quantum_processor or
                megacells:printed_accumulation_processor,
            4 retain 8 Each ae2:printed_silicon,
            4 retain 8 Each minecraft:redstone
        To Each Reaction_Water Bottom Side
    forget

    --量子合金 不同类型液体原料奇点碰撞,导致碰撞原料分配在不同液体环境中，分不清到底是哪个配方的原料
    Input
        minecraft:copper_ingot,
        ae2:singularity,
        advanced_ae:shattered_singularity
    From Ingredient_Reaction_Extra Top Side
        Output
            retain 8 Each minecraft:copper_ingot,
            retain 8 Each ae2:singularity,
            retain 8 Each advanced_ae:shattered_singularity
        To Each Reaction_Quantum Bottom Side
    forget

End